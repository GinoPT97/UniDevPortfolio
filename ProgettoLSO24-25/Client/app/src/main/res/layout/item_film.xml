<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="150dp">

        <!-- Left accent strip (clipped to card corners) -->
        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/primary"/>

        <!-- Poster -->
        <ImageView
            android:id="@+id/imageViewLocandina"
            android:layout_width="86dp"
            android:layout_height="128dp"
            android:layout_gravity="center_vertical"
            android:layout_margin="10dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/film_poster"
            android:background="@drawable/rounded_image_bg"
            android:elevation="2dp"/>

        <!-- Content area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:paddingEnd="10dp">

            <!-- Title + Price row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textViewTitolo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingMultiplier="1.1"/>

                <TextView
                    android:id="@+id/textViewPrezzo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="@color/secondary"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Year -->
            <TextView
                android:id="@+id/textViewAnno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"
                android:textStyle="italic"/>

            <!-- Badges: availability + rating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textViewBadgeDisponibilita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/badge_bg"
                    android:text="Disponibile"
                    android:layout_marginEnd="6dp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/teal_700"
                    android:letterSpacing="0.03"/>

                <TextView
                    android:id="@+id/textViewVotoMedio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 0.0/10"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="@color/orange"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"/>
            </LinearLayout>

            <!-- Action buttons pinned to bottom-end -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|bottom"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/buttonAddToCart"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_round_teal"
                    android:text="＋"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:elevation="3dp"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/buttonRemoveFromCart"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_round_red"
                    android:text="−"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    android:elevation="3dp"
                    android:padding="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
