<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/rounded_dialog_bg"
        android:padding="18dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/dialog_imageViewLocandina"
            android:layout_width="160dp"
            android:layout_height="236dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/film_poster"
            android:background="@drawable/rounded_image_bg"
            android:elevation="2dp"/>

        <TextView
            android:id="@+id/dialog_textViewTitolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginTop="14dp"
            android:textColor="@color/teal_700"
            android:gravity="center"/>

        <TextView
            android:id="@+id/dialog_textViewDescrizione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="10dp"
            android:textColor="#444444"
            android:gravity="center"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/dialog_textViewGenere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/orange"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/dialog_textViewLinguaOriginale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/dialog_textViewDataRilascio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/dialog_textViewStato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/dialog_textViewNumeroCopieDisponibili"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#43A047"/>

        <TextView
            android:id="@+id/dialog_textViewNumeroCopieInPrestito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E53935"/>

        <TextView
            android:id="@+id/dialog_textViewPrezzo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/orange"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_textViewVotoMedio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 0.0/10"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_textViewNumeroVoti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_textViewPopularita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
